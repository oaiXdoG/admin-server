<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xmlns:net="http://www.zfoo.com/schema/net"
       xmlns:event="http://www.zfoo.com/schema/event"
       xmlns:scheduler="http://www.zfoo.com/schema/scheduler"
       xsi:schemaLocation="
             http://www.springframework.org/schema/beans
             http://www.springframework.org/schema/beans/spring-beans.xsd
             http://www.springframework.org/schema/context
             http://www.springframework.org/schema/context/spring-context.xsd
             http://www.zfoo.com/schema/net
             http://www.zfoo.com/schema/net-1.0.xsd
             http://www.zfoo.com/schema/event
             http://www.zfoo.com/schema/event-1.0.xsd
             http://www.zfoo.com/schema/scheduler
             http://www.zfoo.com/schema/scheduler-1.0.xsd">

    <context:property-placeholder location="classpath:application.properties" ignore-unresolvable="false"/>

    <context:component-scan base-package="com.oaixdog.adminbackground"/>

    <net:net id="admin" protocol-location="protocol.xml">
        <net:registry center="zookeeper" path="${zookeeper.path}" user="" password="">
            <net:address name="zookeeper" url="${zookeeper.address}"/>
        </net:registry>
        <net:providers>
            <net:provider protocol-module="admin" provider="admin"/>
        </net:providers>
        <net:consumers>
            <net:consumer consumer="log"/>
        </net:consumers>
    </net:net>

    <!-- 注册 @EventReceiver：ServerRegistryService 在连接断开时移除上报 -->
    <event:event id="eventBus"/>

    <scheduler:scheduler id="daoshinvgui"/>
</beans>
